serviceAccountKey.json
.env
mandate_signing_key.pem
__pycache__/
venv/

# Never rewritten by tooling, never committed. A rename script walked every
# .json in this tree and replaced the project name inside this file, which
# pointed the credentials at a project that does not exist and took the whole
# backend down. Credentials are not text to be find-and-replaced.
backend/serviceAccountKey.json

# Runtime heartbeat from tests/rerun_when_quota_resets.py — a record of a
# particular night, not part of the project.
backend/quota_rerun.log
backend/.env.realdata.bak
backend/firebase.json

# Sector datasets: raw CSVs are large and are not version-controlled.
# backend/data/trip/README.md explains how to rebuild the index from them.
backend/data/*/raw/
backend/data/**/*.sqlite

# Firestore emulator export. Contains real order and payment records
# from test mode — not secrets, but not ours to publish either.
firebase-export/
emulator-dump.json

# Ephemeral in-flight checkout markers — runtime state, never committed.
backend/.inflight/

# Per-process datastore binding registry. Runtime state naming live PIDs —
# meaningless on another machine and actively misleading if committed.
backend/.bindings/

# Emulator and test-run output. Regenerated on every run; committing it
# just makes every diff noisy.
firebase-debug.log
firestore-debug.log
backend/firebase-debug.log
backend/firestore-debug.log
backend/quota_rerun_report.txt
backend/quota_rerun.log
